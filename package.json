{
  "name": "dsh-local-kb",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "外挂本地文件夹知识库：向量检索 + 关键词兜底 + 重排，侧边栏界面可配置",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "node test/kb.test.mjs && node test/ui.test.mjs && node test/pdf.test.mjs"
  },
  "license": "MIT"
}
